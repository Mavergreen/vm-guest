# Disk images are large and, in the case of guest images, must never be
# published. See the "never publish the guest image" rule in the design.
golden/
work/
vendor/cache/
*.qcow2
*.img
*.dmg
*.iso
*.zip

# Run log: machine-generated, append-only, noisy.
run.log

# Python bytecode from image/payload/mkflatpkg.py being imported by tests.
__pycache__/
*.pyc

# bin/triangulate.sh times file creation in the repository to measure G12,
# in a directory it removes. If a run is interrupted, the directory is what
# is left; it is never something to commit.
.mqg-triangulate.*
triangulate-logs-*/

# VERSION is a build product: build/version.sh writes it, the tags
# are the record. A committed copy drifts (family-conventions check 7).
/VERSION
